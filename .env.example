MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me
REDIS_PASSWORD=change-me
AI_ENABLED=false
AI_BASE_URL=https://example.com/v1/chat/completions
AI_API_KEYS=replace-with-api-key
AI_MODEL=replace-with-model
AI_RAG_ENABLED=false
AI_RAG_PROVIDERS=[{"name":"provider-a","baseUrl":"https://example.com/v1","apiKey":"replace-with-api-key","embeddingModel":"embedding-model"}]
# 边缘 WAF 解封端点（POST /security/unban）的运维令牌，需 ≥16 字符；
# 留空时该端点一律返回 404（fail-closed），后台解封只影响应用层封禁
OPENLITEWAF_ADMIN_TOKEN=replace-with-long-random-token
