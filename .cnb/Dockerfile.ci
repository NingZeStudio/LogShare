# CNB CI 构建环境镜像：PHP 8.5 + Swoole 6.2 + CI 所需扩展。
#
# 与生产镜像 docker/hyperf.Dockerfile 的差异是刻意的：
#   1) 不编译 SpinYarn 扩展。CI 不验证反混淆链路，且 phpstan.neon 已排除
#      SpinYarnClient；把 Rust 工具链搬进 CI 只会让每次构建多等几分钟。
#   2) 额外安装 pcov（覆盖率驱动）与 default-mysql-client（便于人工排障）。
#   3) 不安装 jemalloc——那是为常驻进程 RSS 回落准备的，CI 单次执行不需要。
#
# 该镜像由 .cnb.yml 在流水线内 docker build 构建，不推送也不对外发布。
# 改了这里就必须同步检查 SWOOLE_VERSION 是否仍与生产镜像一致。

FROM php:8.5.0-cli-bookworm

COPY --from=composer:2.8.9 /usr/bin/composer /usr/bin/composer

# 供应链提示：install-php-extensions 固定版本 tag，但未 pin 校验和，
# 与生产 Dockerfile 保持同一取舍
ADD https://github.com/mlocati/docker-php-extension-installer/releases/download/2.7.0/install-php-extensions /usr/local/bin/install-php-extensions
RUN chmod +x /usr/local/bin/install-php-extensions \
    && install-php-extensions pdo_mysql pdo_sqlite redis zip pcntl posix sockets mbstring brotli pcov

ARG SWOOLE_VERSION=6.2.0
RUN apt-get update && apt-get install -y --no-install-recommends \
        autoconf build-essential libcurl4-openssl-dev libssl-dev zlib1g-dev libc-ares-dev libbrotli-dev \
        default-mysql-client \
    && pecl install swoole-${SWOOLE_VERSION} \
    && docker-php-ext-enable swoole \
    && rm -rf /var/lib/apt/lists/*

# git：Stage 内的代码风格检查要用
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
