includes:
  - vendor/phpstan/phpstan-phpunit/extension.neon

parameters:
  level: 5
  paths:
    - app
  ignoreErrors:
    # Aternos Codex type hierarchy: analyse() lives on AnalysableLogInterface,
    # while detect() returns the base LogInterface. Runtime classes implement both.
    - message: '#Call to an undefined method Aternos\\Codex\\Log\\Log::analyse#'
      path: app/Log.php
    # Hyperf\Response::getConnection() is dispatched via __call to the underlying
    # Swoole response; withHeader() chains narrow the inferred type to
    # ResponseInterface, so both shapes are ignored.
    - message: '#Call to an undefined method (Hyperf\\HttpServer\\Response|Psr\\Http\\Message\\ResponseInterface)::getConnection\(\)#'
      path: app/Sse/SseWriter.php
