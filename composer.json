{
    "name": "yansui/logshare",
    "description": "Modern Minecraft server log analysis and sharing platform",
    "authors": [
        {
            "name": "YanSui",
            "email": "lyl518@outlook.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "mongodb/mongodb": "2.1.2",
        "ext-json": "*",
        "aternos/codex-minecraft": "^5.1.0",
        "ext-zlib": "*",
        "ext-mbstring": "*",
        "aternos/codex-hytale": "^2.0.0",
        "hyperf/framework": "~3.2.0",
        "hyperf/engine": "^2.0",
        "hyperf/http-server": "~3.2.0",
        "hyperf/config": "~3.2.0",
        "hyperf/di": "~3.2.0",
        "hyperf/dispatcher": "~3.2.0",
        "hyperf/exception-handler": "~3.2.0",
        "hyperf/command": "~3.2.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-arch": "^3.0",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "malith124/stubs-mongodb-11": "^1.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "LogShare\\": "src/",
            "": "src/"
        },
        "files": [
            "core.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage",
        "test:architecture": "pest --plugin=pestphp/pest-plugin-arch",
        "stan": "phpstan analyse src --level=5",
        "cs-fix": "php-cs-fixer fix"
    }
}
